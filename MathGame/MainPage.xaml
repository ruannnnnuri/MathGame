<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MathGame.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25" HorizontalOptions="Fill" VerticalOptions="Center">
            
            <Label Text="Desafio Matemático"
                FontSize="32" HorizontalOptions="Center" VerticalOptions="Start"/>
            <Image Source="mathlogo.png" Aspect="Center"
                HorizontalOptions="Center" VerticalOptions="Center"/>
            <Label Text="Selecione a dificuldade abaixo:" FontSize="18"
                HorizontalOptions="Center" VerticalOptions="Start"/>
            
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <RadioButton x:Name="rbFacil" GroupName="ModoJogo" HorizontalOptions="Center"
                 Content="Fácil" 
                 Value="0"
                 CheckedChanged="Modo_CheckedChanged"/>

                <RadioButton x:Name="rbMedio" GroupName="ModoJogo" HorizontalOptions="Center"
                 Content="Médio" 
                 Value="1"
                 CheckedChanged="Modo_CheckedChanged"/>

                <RadioButton x:Name="rbDificil" GroupName="ModoJogo" HorizontalOptions="Center"
                 Content="Difícil" 
                 Value="2"
                 CheckedChanged="Modo_CheckedChanged"/>
            </HorizontalStackLayout>
            
            <Button x:Name="btJogar" Text="Iniciar Jogo" Clicked="btJogar_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
